		grid-template-columns: repeat(3, 1fr);
		gap: 1.1rem;
	}
	.num {
		padding: 1.4rem;
	}
	.num b {
		display: block;
		font-size: 2.5rem;
		line-height: 1.05;
		letter-spacing: -0.03em;
	}
	.num span {
		display: block;
		margin-top: 0.4rem;
		font-size: 0.875rem;
		color: var(--k-soft);
	}
	.num small {
		display: block;
		margin-top: 0.6rem;
