		text-decoration: none;
	}
	a:hover {
		text-decoration: underline;
	}
	.more {
		margin: 1.25rem 0 0;
		font-size: 0.9rem;
	}
	.mono {
		font-family: var(--sl-font-mono);
	}
	.card {
		background: var(--k-panel);
		border: 1px solid var(--k-line);
		border-radius: 0.9rem;
		overflow: hidden;
	}
	h3 {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		margin: 0;
		padding: 0.7rem 1rem;
		font-size: 0.85rem;
		border-bottom: 1px solid var(--k-line);
		color: var(--k-ink);
	}
	.window .bar {
		display: flex;
		gap: 0.5rem;
		align-items: center;
		padding: 0.55rem 0.9rem;
		border-bottom: 1px solid var(--k-line);
		font: 0.75rem var(--sl-font-mono);
		color: var(--k-faint);
