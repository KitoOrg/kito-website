		display: grid;
		grid-template-columns: repeat(6, 1fr);
		gap: 0.6rem;
		margin: 0;
		padding: 2.1rem 0 0;
		list-style: none;
	}
	.stations::before {
		content: '';
		position: absolute;
		left: 0.4rem;
